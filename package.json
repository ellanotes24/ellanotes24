{
  "name": "pes-pro-x-suite",
  "private": true,
  "version": "0.1.0",
  "description": "PES Next / Pro Exchange Suite monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @pes/api run start:dev",
    "dev:web": "npm --workspace @pes/web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace @pes/api run build",
    "build:web": "npm --workspace @pes/web run build",
    "test": "npm --workspace @pes/api run test",
    "db:generate": "npm --workspace @pes/api run prisma:generate",
    "db:migrate": "npm --workspace @pes/api run prisma:migrate",
    "db:seed": "npm --workspace @pes/api run prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
