generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  BANNED
  UNDER_REVIEW
}

enum UserRole {
  MEMBER
  PREMIUM_MEMBER
  MODERATOR
  ADMIN
  SUPER_ADMIN
  ADVERTISER
  SUPPORT_AGENT
}

enum WalletType {
  CREDITS
  COINS
  CASH
  BONUS
  REFERRAL
  PENDING
  LOCKED
  PROMO
}

enum LedgerDirection { CREDIT DEBIT }
enum CampaignStatus { DRAFT PENDING_REVIEW APPROVED REJECTED PAUSED COMPLETED EXHAUSTED FLAGGED }
enum SubmissionStatus { PENDING APPROVED REJECTED }
enum WithdrawalStatus { PENDING APPROVED REJECTED PAID }

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  username       String        @unique
  passwordHash   String
  role           UserRole      @default(MEMBER)
  status         UserStatus    @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  riskScore      Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  profile        UserProfile?
  wallets        Wallet[]
  sessions       Session[]
  loginAttempts  LoginAttempt[]
  campaigns      Campaign[]
  referralLinks  ReferralLink[]
  notifications  Notification[]
  supportTickets SupportTicket[]
}

model Role { id String @id @default(cuid()) name String @unique permissions Permission[] }
model Permission { id String @id @default(cuid()) key String @unique roleId String? role Role? @relation(fields: [roleId], references: [id]) }
model Session { id String @id @default(cuid()) userId String user User @relation(fields:[userId], references:[id]) ipAddress String userAgent String expiresAt DateTime createdAt DateTime @default(now()) }
model LoginAttempt { id String @id @default(cuid()) userId String? user User? @relation(fields:[userId], references:[id]) email String ipAddress String successful Boolean @default(false) createdAt DateTime @default(now()) }
model UserProfile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id])
  avatarUrl String?
  countryCode String?
  timezone String? @default("UTC")
  language String? @default("en")
  membershipTier String? @default("free")
  referralCode String? @unique
  kycStatus String? @default("not_required")
  payoutSettings Json?
  notificationPreferences Json?
}
model Wallet { id String @id @default(cuid()) userId String user User @relation(fields:[userId], references:[id]) type WalletType balance Decimal @default(0) @db.Decimal(18,4) lockedUntil DateTime? @@unique([userId, type]) ledger WalletLedger[] }
model WalletLedger { id String @id @default(cuid()) walletId String wallet Wallet @relation(fields:[walletId], references:[id]) direction LedgerDirection amount Decimal @db.Decimal(18,4) balanceAfter Decimal @db.Decimal(18,4) sourceType String sourceId String? reason String metadata Json? createdAt DateTime @default(now()) }
model Transaction { id String @id @default(cuid()) userId String type String status String amount Decimal @db.Decimal(18,4) reference String @unique metadata Json? createdAt DateTime @default(now()) }
model Deposit { id String @id @default(cuid()) userId String amount Decimal @db.Decimal(18,4) gateway String status String idempotencyKey String @unique createdAt DateTime @default(now()) }
model Withdrawal { id String @id @default(cuid()) userId String amount Decimal @db.Decimal(18,4) fee Decimal @db.Decimal(18,4) status WithdrawalStatus @default(PENDING) method String notes String? transactionRef String? createdAt DateTime @default(now()) }
model PayoutAccount { id String @id @default(cuid()) userId String method String label String encryptedPayload String isDefault Boolean @default(false) createdAt DateTime @default(now()) }
model Campaign { id String @id @default(cuid()) ownerId String owner User @relation(fields:[ownerId], references:[id]) type String status CampaignStatus @default(DRAFT) title String url String budget Decimal @db.Decimal(18,4) spent Decimal @default(0) @db.Decimal(18,4) dailyCap Decimal? @db.Decimal(18,4) startsAt DateTime? endsAt DateTime? qualityScore Int @default(0) createdAt DateTime @default(now()) stats CampaignStat[] targets CampaignTarget[] tasks Task[] }
model CampaignStat { id String @id @default(cuid()) campaignId String campaign Campaign @relation(fields:[campaignId], references:[id]) date DateTime impressions Int @default(0) clicks Int @default(0) conversions Int @default(0) }
model CampaignTarget { id String @id @default(cuid()) campaignId String campaign Campaign @relation(fields:[campaignId], references:[id]) countryCode String? deviceType String? category String? }
model BannerCampaign { id String @id @default(cuid()) campaignId String? slotId String? imageUrl String targetUrl String impressions Int @default(0) clicks Int @default(0) }
model AdSlot { id String @id @default(cuid()) key String @unique name String position String allowedSizes Json }
model TaskType { id String @id @default(cuid()) key String @unique name String enabled Boolean @default(true) requiresProof Boolean @default(false) config Json? }
model Task { id String @id @default(cuid()) campaignId String? campaign Campaign? @relation(fields:[campaignId], references:[id]) typeId String type TaskType @relation(fields:[typeId], references:[id]) title String reward Decimal @db.Decimal(18,4) timerSeconds Int status String @default("active") config Json? createdAt DateTime @default(now()) submissions TaskSubmission[] }
model TaskSubmission { id String @id @default(cuid()) taskId String task Task @relation(fields:[taskId], references:[id]) userId String status SubmissionStatus @default(PENDING) proofNote String? reviewerComment String? fraudScore Int @default(0) createdAt DateTime @default(now()) proofUploads ProofUpload[] }
model ProofUpload { id String @id @default(cuid()) submissionId String submission TaskSubmission @relation(fields:[submissionId], references:[id]) fileId String? note String? }
model OfferwallProvider { id String @id @default(cuid()) key String @unique name String enabled Boolean @default(true) config Json }
model OfferwallCallback { id String @id @default(cuid()) providerId String provider OfferwallProvider @relation(fields:[providerId], references:[id]) callbackId String @unique userId String amount Decimal @db.Decimal(18,4) status String rawPayload Json createdAt DateTime @default(now()) }
model ReferralLink { id String @id @default(cuid()) userId String user User @relation(fields:[userId], references:[id]) code String @unique clicks Int @default(0) }
model ReferralEvent { id String @id @default(cuid()) referrerUserId String referredUserId String type String rewardAmount Decimal @db.Decimal(18,4) status String metadata Json? createdAt DateTime @default(now()) }
model Membership { id String @id @default(cuid()) userId String planId String startsAt DateTime endsAt DateTime status String }
model MembershipPlan { id String @id @default(cuid()) key String @unique name String price Decimal @db.Decimal(18,4) durationDays Int benefits Json isActive Boolean @default(true) }
model Subscription { id String @id @default(cuid()) userId String planId String gateway String externalId String? status String renewsAt DateTime? }
model Coupon { id String @id @default(cuid()) code String @unique kind String value Decimal @db.Decimal(18,4) maxRedemptions Int? expiresAt DateTime? }
model Achievement { id String @id @default(cuid()) key String @unique name String xpReward Int criteria Json }
model UserAchievement { id String @id @default(cuid()) userId String achievementId String earnedAt DateTime @default(now()) }
model Level { id String @id @default(cuid()) rank Int @unique name String minXp Int perks Json? }
model UserLevel { id String @id @default(cuid()) userId String @unique levelId String xp Int @default(0) }
model Notification { id String @id @default(cuid()) userId String user User @relation(fields:[userId], references:[id]) type String title String body String readAt DateTime? createdAt DateTime @default(now()) }
model SupportTicket { id String @id @default(cuid()) userId String user User @relation(fields:[userId], references:[id]) category String priority String status String subject String message String assignedAdminId String? createdAt DateTime @default(now()) replies TicketReply[] }
model TicketReply { id String @id @default(cuid()) ticketId String ticket SupportTicket @relation(fields:[ticketId], references:[id]) authorId String message String internalNote Boolean @default(false) createdAt DateTime @default(now()) }
model CmsPage { id String @id @default(cuid()) slug String @unique title String content Json status String @default("published") }
model BlogPost { id String @id @default(cuid()) slug String @unique title String excerpt String? content Json tags String[] status String publishedAt DateTime? }
model FaqEntry { id String @id @default(cuid()) category String question String answer String sortOrder Int @default(0) isActive Boolean @default(true) }
model Setting { id String @id @default(cuid()) group String key String value Json @@unique([group, key]) }
model AuditLog { id String @id @default(cuid()) actorId String? action String entityType String entityId String? metadata Json? createdAt DateTime @default(now()) }
model FraudEvent { id String @id @default(cuid()) userId String? code String score Int metadata Json? reviewed Boolean @default(false) createdAt DateTime @default(now()) }
model Blacklist { id String @id @default(cuid()) type String value String reason String? active Boolean @default(true) createdAt DateTime @default(now()) }
model Country { code String @id name String enabled Boolean @default(true) }
model Language { code String @id name String enabled Boolean @default(true) }
model CronRun { id String @id @default(cuid()) key String startedAt DateTime endedAt DateTime? status String report Json? }
model AdminNote { id String @id @default(cuid()) entityType String entityId String authorId String note String createdAt DateTime @default(now()) }
model FileUpload { id String @id @default(cuid()) ownerId String? path String mimeType String size Int checksum String? createdAt DateTime @default(now()) }
